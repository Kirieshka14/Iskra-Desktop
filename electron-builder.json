{
  "appId": "place.run.iskraai.desktop",
  "productName": "Iskra",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron-main.cjs",
    "iskra.config.json",
    "package.json"
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["universal", "x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["universal", "x64", "arm64"]
      }
    ],
    "category": "public.app-category.entertainment",
    "artifactName": "Iskra-${version}-${arch}.${ext}",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "Установка Iskra",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "target": ["nsis", "portable"],
    "artifactName": "Iskra-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  },
  "linux": {
    "target": ["deb", "AppImage"],
    "category": "Roleplaying",
    "artifactName": "iskra_${version}_${arch}.${ext}"
  }
}
