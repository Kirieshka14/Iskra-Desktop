{
  "appId": "place.run.iskraai.desktop",
  "productName": "Iskra",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron-main.cjs",
    "iskra.config.json",
    "package.json"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "artifactName": "Iskra-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  },
  "linux": {
    "target": ["deb", "AppImage"],
    "category": "Roleplaying",
    "artifactName": "iskra_${version}_${arch}.${ext}"
  }
}
